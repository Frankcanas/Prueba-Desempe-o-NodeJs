# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=nodejs
DB_PASSWORD=123456
DB_NAME=postgres

# JWT Configuration
JWT_SECRET=secret_key
JWT_EXPIRES_IN=30m

# Docker Configuration
DB_CONTAINER_NAME=riwimedicare-db
APP_CONTAINER_NAME=riwimedicare-backend
DB_CPU_LIMIT=2
DB_MEM_LIMIT=512MB
APP_CPU_LIMIT=2
APP_MEM_LIMIT=512MB
